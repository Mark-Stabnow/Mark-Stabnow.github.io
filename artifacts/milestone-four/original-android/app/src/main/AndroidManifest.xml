<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventoryApp">
        <activity
            android:name=".AccountActivity"
            android:exported="false" />
        <activity
            android:name=".QuantityAdjustActivity"
            android:exported="false" />
        <activity
            android:name=".RestockActivity"
            android:exported="false" />
        <activity
            android:name=".ItemDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".InventoryItemFormActivity"
            android:exported="false" />
        <activity
            android:name=".SMSNotificationActivity"
            android:exported="false" />
        <activity
            android:name=".WarehouseInventoryActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
